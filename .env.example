# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="My App"

# Auth — server-only (no NEXT_PUBLIC_ prefix)
# Generate: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
SESSION_COOKIE_NAME=session

# API
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Serve mock/fixture data instead of calling the real backend.
# Set to "false" once the real backend is ready.
NEXT_PUBLIC_USE_MOCK_API=true

# Site-wide maintenance mode — set to "true" to redirect all traffic to /maintenance
MAINTENANCE_MODE=false
